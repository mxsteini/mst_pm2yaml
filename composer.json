{
    "name": "mstitb/mst-pm2yaml",
    "description": "Powermail-Formulare als YAML-Datei: Datei als Quelle, Powermail arbeitet unverändert mit der Datenbank.",
    "type": "typo3-cms-extension",
    "license": "proprietary",
    "homepage": "https://github.com/mxsteini/mst_pm2yaml",
    "support": {
        "issues": "https://github.com/mxsteini/mst_pm2yaml/issues"
    },
    "require": {
        "php": ">=8.2 <8.6",
        "typo3/cms-core": "^13.4",
        "typo3/cms-backend": "^13.4",
        "in2code/powermail": "^13.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "typo3/testing-framework": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "MSTITB\\MstPm2yaml\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSTITB\\MstPm2yaml\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "mst_pm2yaml"
        }
    }
}
