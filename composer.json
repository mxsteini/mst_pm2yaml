{
    "name": "mstitb/mst-pm2yaml",
    "description": "Powermail-Formulare als YAML-Datei: Datei als Quelle, Powermail arbeitet unverändert mit der Datenbank.",
    "type": "typo3-cms-extension",
    "license": "proprietary",
    "require": {
        "typo3/cms-core": "^13.4",
        "typo3/cms-backend": "^13.4",
        "in2code/powermail": "^13.0",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "MSTITB\\MstPm2yaml\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "mst_pm2yaml"
        }
    }
}
